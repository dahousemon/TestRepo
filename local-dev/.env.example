# =============================================================================
# Local Development Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server Configuration
# -----------------------------------------------------------------------------

# SQL Server admin password (must be strong)
SQL_ADMIN_PASSWORD=YourStrong@Passw0rd123

# MCP read-only user credentials
SQL_USER=mcp_user
SQL_PASSWORD=McpUser@Pass123

# SQL Server connection details (for local development)
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=DevOpsMetrics

# Full connection string (used by MCP server)
SQL_CONNECTION_STRING=Server=localhost,1433;Database=DevOpsMetrics;User ID=mcp_user;Password=McpUser@Pass123;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------

# Node environment
NODE_ENV=development

# Log level (error, warn, info, debug)
LOG_LEVEL=debug

# Health check port
HEALTH_PORT=8080

# -----------------------------------------------------------------------------
# Azure Configuration (for cloud deployment)
# -----------------------------------------------------------------------------

# Azure Resource Group
AZURE_RESOURCE_GROUP=rg-mcp-server-dev

# Azure Region
AZURE_REGION=eastus

# Azure SQL Server details
AZURE_SQL_SERVER=sql-mcpsql-dev-abcd12.database.windows.net
AZURE_SQL_DATABASE=DevOpsMetrics
AZURE_SQL_USER=sqladmin

# Azure Container Registry
ACR_NAME=acrmcpsqldevabcd

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# Adminer port (SQL management UI)
ADMINER_PORT=8090

# MCP Server port
MCP_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
# 1. Never commit real passwords to git
# 2. Use Azure Key Vault for production secrets
# 3. Rotate credentials regularly
# 4. Use strong passwords (min 12 chars, mixed case, numbers, symbols)
# =============================================================================
