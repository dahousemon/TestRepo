{
  "mcpServers": {
    "sql-devops-metrics": {
      "command": "node",
      "args": [
        "/absolute/path/to/sql-mcp-server/src/server.js"
      ],
      "env": {
        "SQL_CONNECTION_STRING": "Server=localhost,1433;Database=DevOpsMetrics;User ID=mcp_user;Password=McpUser@Pass123;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "HEALTH_PORT": "8080"
      }
    }
  }
}
